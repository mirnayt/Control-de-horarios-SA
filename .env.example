# Spirit Academia — copiar a .env y ajustar (nunca versionar .env)
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

DJANGO_SECRET_KEY=dev-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 1 = SQLite (dev). 0 = PostgreSQL (prod / migración futura)
DJANGO_USE_SQLITE=1
POSTGRES_DB=spirit_academia
POSTGRES_USER=spirit
POSTGRES_PASSWORD=spirit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
