# Spirit Academia — copiar a .env y ajustar (nunca versionar .env)
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

DJANGO_SECRET_KEY=dev-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Prod (Railway): https://<servicio>.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# 1 = SQLite (dev). 0 = PostgreSQL (prod / Railway)
DJANGO_USE_SQLITE=1

# Railway inyecta DATABASE_URL al vincular Postgres. Si está definida, tiene prioridad.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# POSTGRES_SSL_REQUIRE=1

POSTGRES_DB=spirit_academia
POSTGRES_USER=spirit
POSTGRES_PASSWORD=spirit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Usuarios operativos (create_ops_users / release Railway)
# OPS_RECEPCION_USERNAME=recepcion
# OPS_DIRECCION_USERNAME=direccion
# OPS_RECEPCION_PASSWORD=cambia-esto
# OPS_DIRECCION_PASSWORD=cambia-esto

# Solo prod detrás de proxy HTTPS (default 1 si DJANGO_DEBUG=0)
# DJANGO_SECURE_SSL_REDIRECT=1
